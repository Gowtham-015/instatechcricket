# ===== Instagram (Graph API) =====
IG_USER_ID=
IG_ACCESS_TOKEN=
# Facebook Login (default):  https://graph.facebook.com
# Instagram Login:           https://graph.instagram.com
IG_API_HOST=https://graph.facebook.com
# Token starts with IGAA...  -> use https://graph.instagram.com  (Instagram Login)
IG_API_VERSION=v26.0

# ===== Facebook Page (optional): publish the same content to the Page connected to your Instagram =====
# Needs a PAGE token from Facebook Login with pages_manage_posts (NOT the Instagram Login token).
# Get both values with:  python main.py fb-pages --user-token <Graph API Explorer user token>
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# crosspost = same Reel/photos as Instagram | link = Telegram-style link post (Facebook shows the article's own
# preview picture) | both | off
FB_MODE=crosspost

# ===== AI (Google Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ===== Brand =====
BRAND_NAME=Daily Pulse
ACCOUNT_HANDLE=@yourhandle
BRAND_HASHTAGS=#dailypulse

# ===== Media hosting: cloudinary | github | local =====
MEDIA_HOST=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# github host (GITHUB_TOKEN / GITHUB_REPOSITORY are injected by GitHub Actions)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
MEDIA_BRANCH=media
# local host (you serve ./public/media yourself)
MEDIA_BASE_URL=

# ===== Posting plan (IST) =====
TIMEZONE=Asia/Kolkata
POST_TIMES=09:00,13:00,18:00,21:00
SLOT_GRACE_MINUTES=90
MAX_POSTS_PER_DAY=6
MIN_POST_INTERVAL_MINUTES=60
CATEGORY_WEIGHTS=News:3,Technology:3,Sports:2,Entertainment:2

# ===== Formats: carousel (image slides) and reel (vertical video) =====
# Weights decide the mix. carousel:1,reel:1 alternates. Use reel:1 for video only, carousel:1 for images only.
CONTENT_FORMATS=carousel:1,reel:1
VIDEO_SECONDS_PER_SLIDE=4
VIDEO_FPS=30
REEL_SHARE_TO_FEED=true
# dynamic = real Reel (stock footage + voiceover + animated captions). cards = old info-card slideshow.
REEL_STYLE=dynamic
# Footage for the Reel background (tried in this order, all optional):
#  1) PIXABAY_API_KEY  free key: https://pixabay.com/api/docs/   (landscape clips are centre-cropped to 9:16)
#  2) PEXELS_API_KEY   https://www.pexels.com/api/  (new keys are sometimes paused)
#  3) BROLL_DIR        a folder with YOUR OWN clips, no account needed. Sub-folders News, Technology, Sports,
#                      Entertainment are matched to the story category.  Check them with: python main.py clips
#  4) nothing          animated moving background
# Real documentary photos of the story's people/places/institutions from Wikimedia Commons (free licences, no key).
# Each photo is credited on screen and in the caption. Set false to disable.
REAL_PHOTOS=true
# Photo sources: commons (Wikimedia, no key) and openverse (open-licensed Flickr/NASA/Smithsonian photos).
PHOTO_SOURCES=commons,openverse
# YOUR OWN photo library (photos you took, bought, or have written permission to use). Always tried first.
# Name files after what they show, credit after a double underscore:  narendra_modi_eknath_shinde__PIB.jpg
PHOTO_DIR=
# Optional free Openverse OAuth client (raises the anonymous limit of ~5 requests/hour). See README.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
OPENVERSE_SOURCES=flickr,nasa,smithsonian

# ===== Trending =====
# Stories matching Google Trends' "trending now" searches get a ranking bonus.
TRENDS_ENABLED=true
TRENDS_GEO=IN
# A story must be reported by at least this many outlets (or match a Google trend). 1 = no rule.
MIN_SOURCES=2
STOCK_PROVIDER=auto
PIXABAY_API_KEY=
PEXELS_API_KEY=
BROLL_DIR=
# Voiceover: auto | edge | gemini | none.  Indian English voices: en-IN-NeerjaNeural (female), en-IN-PrabhatNeural (male)
TTS_PROVIDER=auto
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+6%
# Voice used when Gemini TTS is the one speaking (Kore, Puck, Charon, Fenrir, Leda, Aoede, Zephyr ...)
GEMINI_TTS_VOICE=Kore
FOOTAGE_CREDIT=true
# Optional ROYALTY-FREE music (mp3/m4a/wav) you have the rights to use; played quietly under the voice.
MUSIC_PATH=
MUSIC_VOLUME=0.12

# ===== Safety / ops =====
DRY_RUN=false
SKIP_SENSITIVE=true
ALERT_WEBHOOK_URL=

# --- Variety: every Reel gets a different look and sound ------------------------------------------------
# true  = rotate voice, speaking speed/pitch, caption colour and size, headline layout, colour grade, outro line
#         and the script's opening style. The last Reels are remembered, so two in a row never match.
# false = always the same classic look.
REEL_VARIETY=true
# Voices rotated between Reels (comma separated edge-tts voices). Put ONE voice here to keep a single voice.
TTS_VOICES=en-IN-NeerjaNeural,en-IN-PrabhatNeural

# --- News sources ---------------------------------------------------------------------------------------
# The agent already reads the same 15 feeds as your Telegram bot (NDTV, Times of India, The Hindu, BBC, Economic Times,
# TechCrunch, Wired, The Verge, ESPNcricinfo, Variety, Hollywood Reporter ...). Add more RSS feeds here, separated by ';':
#   Category|Name|URL      Category = News, Technology, Sports or Entertainment
# Test them with:  python main.py sources
EXTRA_FEEDS=

# =====================================================================================================================
# EDITORIAL NEWSROOM (v2): the story and the media actually found decide the format
# =====================================================================================================================
# editorial = the engine picks original video / photo / carousel / Reel / fact card per story (CONTENT_FORMATS is ignored)
# legacy    = the old behaviour: CONTENT_FORMATS weights alternate carousel and Reel
FORMAT_POLICY=editorial

# --- Where authentic media may come from (tried in this order) ---------------------------------------------------
#   official  media attached to the news items themselves, ONLY from OFFICIAL_MEDIA_DOMAINS or with a declared open licence
#   local     your own PHOTO_DIR / VIDEO_DIR (files you own or have written permission for)
#   commons   Wikimedia Commons (CC0 / Public Domain / CC BY / GODL-India only; share-alike, NC, ND are refused)
#   openverse Openverse (open-licensed Flickr / NASA / Smithsonian photos)
MEDIA_SOURCE_ORDER=official,local,commons,openverse
# A photo/video scoring below this match confidence (0..1) is rejected. Higher = stricter, fewer photos, safer.
MEDIA_MIN_CONFIDENCE=0.6
# Smallest acceptable photo (px). Instagram scales feed images to 1080-1440 px wide, so tiny photos look poor.
MEDIA_MIN_WIDTH=1000
MEDIA_MIN_HEIGHT=600
# Only "strict" exists: unlicensed or unclear media is never downloaded, never published.
MEDIA_LICENSE_POLICY=strict
# Domains whose media you are allowed to republish (agencies that publish for reuse). Comma separated. Add ONLY domains
# whose terms permit it; the agent also honours robots.txt.   Example: nasa.gov,images.nasa.gov,pib.gov.in
OFFICIAL_MEDIA_DOMAINS=nasa.gov,images.nasa.gov
# A folder of YOUR authorised event videos. Each video needs  <name>.mp4.rights.json  describing what it is, who owns it
# and why you may post it (see README "Authorised video"). A video without a rights file is never used.
VIDEO_DIR=
# Openly licensed (CC BY / CC0 / Public Domain) videos from Wikimedia Commons.
COMMONS_VIDEO=true
# true  = a photo of the right person/place that is not shown to be from THIS event may be used, with a "FILE PHOTO" badge
# false = only photos shown to depict this event
ALLOW_FILE_PHOTOS=true
# Media older than this many days can never be labelled as the event itself (it becomes a labelled file photo at best).
EVENT_WINDOW_DAYS=3

# --- Format decisions ----------------------------------------------------------------------------------------------
# A story must gain at least this much (0..1) from narration before it becomes a Reel.
REEL_NARRATION_MIN=0.6
# auto = voiceover only when the story needs it | always | never (never = silent captions-only Reels)
REEL_VOICEOVER=auto
# Distinct accepted photos needed before a photo carousel is considered.
CAROUSEL_MIN_PHOTOS=2
# Categories where labelled illustrative stock footage may illustrate a Reel when no real photo exists. Never used for
# politics, sports results, disasters, conflict or any event story.
ILLUSTRATIVE_CATEGORIES=Technology,Science,Business
# An authorised original video must be at least VIDEO_MIN_SECONDS; it is trimmed to VIDEO_MAX_SECONDS
# (Instagram allows 3 s - 15 min; 90 s keeps news Reels tight).
VIDEO_MIN_SECONDS=3
VIDEO_MAX_SECONDS=90

# --- Editorial safety ----------------------------------------------------------------------------------------------
# A story whose confidence (source quality + corroboration + freshness + official source) is below this is held back.
EDITORIAL_MIN_CONFIDENCE=0.35
# Election, disaster, conflict, health and crime stories need this many independent outlets (or an official source).
MIN_CORROBORATION_SENSITIVE=2
# Stories with at least this score, 3+ outlets and under 12 h old override category balancing.
SIGNIFICANT_SCORE=75
BREAKING_ENABLED=true
BREAKING_SCORE=85
BREAKING_MIN_SOURCES=3
SKIP_SENSITIVE=true
ALLOW_FALLBACK_POSTS=true

# --- Sources and trends ---------------------------------------------------------------------------------------------
# A JSON file to add / disable feeds and set source quality without touching code. See README "Configurable sources".
SOURCES_FILE=
# Comma separated feed names to switch off, e.g.  Al Jazeera,Wired
DISABLED_SOURCES=
MAX_NEWS_AGE_HOURS=24
MIN_STORY_SCORE=35
# google = Google Trends daily-trends RSS (unofficial, may be unavailable) | wikipedia = Wikimedia's real daily pageviews.
# An unavailable provider is reported as "unavailable" - never treated as "nothing is trending".
TREND_PROVIDERS=google,wikipedia

# --- Posting limits and retries --------------------------------------------------------------------------------------
IG_DAILY_API_LIMIT=50
MAX_PUBLISH_ATTEMPTS_PER_RUN=2
IG_VIDEO_POLL_TIMEOUT=600
# Records kept in data/decisions.jsonl (the editorial decision log committed by GitHub Actions) and history.
DECISION_LOG_MAX=100
HISTORY_MAX_RECORDS=400
HISTORY_MAX_DAYS=60

# --- Gemini (copy) ---------------------------------------------------------------------------------------------------
AI_MAX_ATTEMPTS=2
AI_CACHE_TTL_HOURS=24
AI_CACHE_MAX_ENTRIES=150

# --- Ops -------------------------------------------------------------------------------------------------------------
# Failure alerts to this webhook are sent at most once per ALERT_THROTTLE_HOURS; after BREAKER_FAILURES consecutive
# failed runs the agent pauses for BREAKER_PAUSE_HOURS.
ALERT_THROTTLE_HOURS=4
BREAKER_FAILURES=5
BREAKER_PAUSE_HOURS=3
# Facebook Graph API version for the Page cross-post (defaults to IG_API_VERSION).
FB_API_VERSION=v26.0
# Folders (defaults are next to the code).
DATA_DIR=
LOG_DIR=
# Optional custom bold .ttf used by the image cards.
FONT_PATH=
